# Configure at least one provider.
TELEGRAM_BOT_TOKEN="<some-example-token>"
# BOT_TOKEN is still supported for Telegram.
# Optional, HTTP proxy for Telegram API requests (supports basic auth in URL).
# Format: http://user:pass@proxy:port or http://proxy:port
# Example: TELEGRAM_PROXY="http://user:pass@proxy:8080"
# TELEGRAM_PROXY="http://proxy:8080"
DEFAULT_INTERVAL=60000

NTFY_BASE_URL="https://ntfy.sh"
NTFY_TOPIC="ktalk-push-example"
# Set to "false" or "0" to disable ntfy provider
NTFY_ENABLED="true"
# Optional, for protected topics.
NTFY_AUTHORIZATION="Bearer <token>"
NTFY_TITLE="KTalk Push"
